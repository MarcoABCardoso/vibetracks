{
  "name": "the-long-road-home",
  "extends": "../soundtrack.json",
  "_comment": "End credits / finale. A journey back through the whole score, gathering tempo as it goes home: the 'sands' theme remembered on english horn with a flute answering its consequent (A, the desert, 90) -> the 'hymn' returning on choir and horn (B, the temple/faith, 96) -> the full hero_theme + fanfare in radiant major, lifted a whole step (C, triumph/close, 104, transpose +2). Every motif gets its farewell; each states a full sentence, and each return varies.",
  "bpm": 90,
  "time_signature": [4, 4],
  "loops": 1,

  "sections": [
    {
      "name": "intro",
      "bars": 4,
      "bpm": 88,
      "_comment": "Looking back: solo harp over an aura pad, a distant clarinet. i - VI - III - V.",
      "parts": {
        "harp":     { "instrument": "harp", "repeat": 8, "pan": 0.2, "gain": 0.5,
                      "notes": [["D4", 0.5], ["A4", 0.5], ["D5", 0.5], ["F5", 0.5]] },
        "aura":     { "instrument": "aura", "chords": ["Dm", "Bb", "F", "A"], "chord_beats": 4, "gain": 0.85 },
        "clarinet": { "instrument": "clarinet", "gain": 0.4, "pan": -0.25,
                      "notes": [["A4", 4], ["F4", 4], ["A4", 4], ["A4", 4]] }
      }
    },
    {
      "name": "A",
      "bars": 8,
      "bpm": 90,
      "_comment": "The desert remembered: english horn sings the full sands sentence; flute answers with its consequent (the high F5 crest); harp and strings hold. Wistful.",
      "parts": {
        "englishhorn": { "instrument": "englishhorn", "motif": "sands", "repeat": 2, "pan": -0.1, "gain": 0.75 },
        "flute":       { "instrument": "flute", "motif": "sands", "slice": [12, 22], "repeat": 4, "pan": 0.3, "gain": 0.4 },
        "strings":     { "instrument": "strings", "chords": ["Dm", "C", "Bb", "A", "Dm", "Gm", "A", "Dm"], "chord_beats": 4, "gain": 0.5 },
