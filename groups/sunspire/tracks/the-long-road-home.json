{
  "name": "the-long-road-home",
  "extends": "../soundtrack.json",
  "_comment": "End credits / finale. A long journey back through the whole score: the 'sands' theme remembered on english horn (A, the desert), the 'hymn' returning on choir and horn (B, the temple/faith), then the full hero_theme + fanfare in radiant major (C, triumph — the loop/close). Every motif gets its farewell.",
  "bpm": 90,
  "time_signature": [4, 4],
  "loops": 1,

  "sections": [
    {
      "name": "intro",
      "bars": 4,
      "_comment": "Looking back: solo harp over an aura pad, a distant clarinet. i - VI - III - V.",
      "parts": {
        "harp":     { "instrument": "harp", "repeat": 8, "pan": 0.2, "gain": 0.5,
                      "notes": [["D4", 0.5], ["A4", 0.5], ["D5", 0.5], ["F5", 0.5]] },
        "aura":     { "instrument": "aura", "chords": ["Dm", "Bb", "F", "A"], "chord_beats": 4, "gain": 0.85 },
        "clarinet": { "instrument": "clarinet", "gain": 0.4, "pan": -0.25,
                      "notes": [["A4", 4], ["F4", 4], ["A4", 4], ["A4", 4]] }
      }
    },
    {
      "name": "A",
      "bars": 8,
      "_comment": "The desert remembered: english horn sings the sands theme; flute answers high; harp and strings hold. Wistful.",
      "parts": {
        "englishhorn": { "instrument": "englishhorn", "motif": "sands", "repeat": 4, "pan": -0.1, "gain": 0.75 },
        "flute":       { "instrument": "flute", "motif": "sands", "slice": [6, 12], "repeat": 4, "transpose": 12, "pan": 0.3, "gain": 0.4 },
        "strings":     { "instrument": "strings", "chords": ["Dm", "C", "Bb", "A", "Dm", "Gm", "A", "Dm"], "chord_beats": 4, "gain": 0.5 },
        "harp":        { "instrument": "harp", "repeat": 8, "pan": 0.24, "gain": 0.42,
                         "notes": [["D4", 0.5], ["F4", 0.5], ["A4", 0.5], ["D5", 0.5],
                                   ["A4", 0.5], ["F4", 0.5], ["D4", 0.5], ["F4", 0.5]] },
        "cello":       { "instrument": "cello", "gain": 0.7,
                         "notes": [["D2", 4], ["C2", 4], ["Bb1", 4], ["A2", 4],
                                   ["D2", 4], ["G2", 4], ["A2", 4], ["D2", 4]] }
      }
    },
    {
      "name": "B",
      "bars": 8,
      "_comment": "Faith returns: choir intones the hymn, horn doubles it warmly, timpani begins to lift, strings swell. The build toward home.",
      "parts": {
        "choir":   { "instrument": "choir", "motif": "hymn", "repeat": 4, "pan": 0.0, "gain": 0.65 },
        "horn":    { "instrument": "horn", "motif": "hymn", "repeat": 4, "pan": -0.15, "gain": 0.6 },
        "oboe":    { "instrument": "oboe", "motif": "hymn", "slice": [0, 3], "repeat": 4, "transpose": 12, "pan": 0.3, "gain": 0.35 },
        "strings": { "instrument": "strings", "chords": ["Dm", "F", "Bb", "Gm", "Dm", "A", "Gm", "A"], "chord_beats": 4, "octave": 4, "gain": 0.55 },
        "harp":    { "instrument": "harp", "repeat": 16, "pan": 0.24, "gain": 0.4,
                     "notes": [["D4", 0.5], ["F4", 0.5], ["A4", 0.5], ["D5", 0.5]] },
        "cello":   { "instrument": "cello", "gain": 0.75,
                     "notes": [["D2", 4], ["F2", 4], ["Bb1", 4], ["G2", 4],
                               ["D2", 4], ["A2", 4], ["G2", 4], ["A2", 4]] },
        "timpani": { "instrument": "timpani", "gain": 0.55,
                     "notes": [["D2", 0.5], [null, 3.5], ["Bb1", 0.5], [null, 3.5],
                               ["D2", 0.5], [null, 3.5], ["A2", 0.5], [null, 1.5], ["A2", 0.5], [null, 1.5]] }
      }
    },
    {
      "name": "C",
      "bars": 8,
      "loop": true,
      "_comment": "Home and triumph (the close): brass and choir sing the full hero_theme in radiant major color; trumpet crowns it with the fanfare; harp, strings, taiko and timpani carry it out. A bright plagal Bb->F lands the final cadence.",
      "parts": {
        "brass":   { "instrument": "brass", "motif": "hero_theme", "repeat": 4, "pan": -0.08, "gain": 0.85 },
        "horn":    { "instrument": "horn", "motif": "hero_theme", "repeat": 4, "transpose": 12, "pan": 0.12, "gain": 0.55 },
        "trumpet": { "instrument": "trumpet", "motif": "fanfare", "repeat": 4, "transpose": 12, "pan": 0.22, "gain": 0.5 },
        "choir":   { "instrument": "choir", "chords": ["Bb", "F", "C", "Dm", "Bb", "F", "C", "F"], "chord_beats": 4, "gain": 0.55 },
        "strings": { "instrument": "strings", "chords": ["Bb", "F", "C", "Dm", "Bb", "F", "C", "F"], "chord_beats": 4, "octave": 4, "gain": 0.55 },
        "harp":    { "instrument": "harp", "repeat": 16, "pan": 0.26, "gain": 0.4,
                     "notes": [["F4", 0.25], ["A4", 0.25], ["C5", 0.25], ["F5", 0.25]] },
        "cello":   { "instrument": "cello", "gain": 0.8,
                     "notes": [["Bb1", 4], ["F2", 4], ["C2", 4], ["D2", 4],
                               ["Bb1", 4], ["F2", 4], ["C2", 4], ["F2", 4]] },
        "bass":    { "instrument": "bass", "gain": 0.7,
                     "notes": [["Bb0", 4], ["F1", 4], ["C1", 4], ["D1", 4],
                               ["Bb0", 4], ["F1", 4], ["C1", 4], ["F1", 4]] },
        "timpani": { "instrument": "timpani", "gain": 0.6,
                     "notes": [["Bb1", 0.5], [null, 3.5], ["F2", 0.5], [null, 3.5],
                               ["C2", 0.5], [null, 3.5], ["D2", 0.5], [null, 3.5],
                               ["Bb1", 0.5], [null, 3.5], ["F2", 0.5], [null, 3.5],
                               ["C2", 1], ["C2", 1], ["F2", 2], ["F2", 4]] },
        "taiko":   { "instrument": "taiko", "gain": 0.45, "pan": -0.12,
                     "notes": [["D2", 1], ["D2", 1], ["D2", 1], ["D2", 1]], "repeat": 8 }
      }
    }
  ]
}
