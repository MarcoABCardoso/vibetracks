        "oboe":    { "instrument": "oboe", "motif": "hymn", "slice": [6, 12], "repeat": 4, "transpose": 12, "pan": 0.3, "gain": 0.35 },
        "strings": { "instrument": "strings", "chords": ["Dm", "F", "Bb", "Gm", "Dm", "A", "Gm", "A"], "chord_beats": 4, "octave": 4, "gain": 0.55 },
        "harp":    { "instrument": "harp", "arp": ["Dm", "F", "Bb", "Gm", "Dm", "A", "Gm", "A"], "rate": 0.5, "pattern": "up", "octaves": 1, "octave": 4, "pan": 0.24, "gain": 0.4 },
