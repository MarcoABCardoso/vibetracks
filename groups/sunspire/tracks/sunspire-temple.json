{
  "name": "sunspire-temple",
  "extends": "../soundtrack.json",
  "_comment": "The safe/sacred cue: inside the great sun-temple. The choir sings the reverent 'hymn'; english horn answers; a flute quotes only the first cell of the hero_theme (slice) as a distant callback. Slow, spacious, plagal — mood over melody.",
  "bpm": 76,
  "time_signature": [4, 4],
  "loops": 1,

  "sections": [
    {
      "name": "intro",
      "bars": 4,
      "_comment": "Incense and light. Aura + choir pad on i - III - VI - iv, harp shimmer, a single soft timpani.",
      "parts": {
        "aura":    { "instrument": "aura", "chords": ["Dm", "F", "Bb", "Gm"], "chord_beats": 4 },
        "choir":   { "instrument": "choir", "chords": ["Dm", "F", "Bb", "Gm"], "chord_beats": 4, "gain": 0.45 },
        "harp":    { "instrument": "harp", "repeat": 4, "pan": 0.25, "gain": 0.5,
                     "notes": [["D4", 1], ["F4", 1], ["A4", 1], ["D5", 1]] },
        "timpani": { "instrument": "timpani", "gain": 0.5,
                     "notes": [["D2", 0.5], [null, 7.5], ["Bb1", 0.5], [null, 7.5]] }
      }
    },
    {
      "name": "A",
      "bars": 8,
      "loop": true,
      "_comment": "Choir intones the hymn; english horn answers a phrase behind; flute quotes just the hero_theme's opening cell high above; strings and harp sustain the light. Reverent, unhurried.",
      "parts": {
        "choir":       { "instrument": "choir", "motif": "hymn", "repeat": 4, "pan": 0.0, "gain": 0.7 },
        "englishhorn": { "instrument": "englishhorn", "motif": "hymn", "repeat": 4, "transpose": -12, "stretch": 1.0, "pan": -0.25, "gain": 0.45 },
        "flute":       { "instrument": "flute", "motif": "hero_theme", "slice": [0, 3], "repeat": 4, "transpose": 12, "stretch": 2.0, "pan": 0.3, "gain": 0.4 },
        "strings":     { "instrument": "strings", "chords": ["Dm", "F", "Bb", "Gm", "Dm", "A", "Gm", "Dm"], "chord_beats": 4, "gain": 0.55 },
        "harp":        { "instrument": "harp", "repeat": 8, "pan": 0.25, "gain": 0.45,
                         "notes": [["D4", 0.5], ["A4", 0.5], ["D5", 0.5], ["F5", 0.5],
                                   ["A5", 0.5], ["F5", 0.5], ["D5", 0.5], ["A4", 0.5]] },
        "cello":       { "instrument": "cello",
                         "notes": [["D2", 4], ["F2", 4], ["Bb1", 4], ["G2", 4],
                                   ["D2", 4], ["A2", 4], ["G2", 4], ["D2", 4]] },
        "aura":        { "instrument": "aura", "chords": ["Dm", "Bb", "Dm", "A"], "chord_beats": 8, "gain": 0.7 }
      }
    }
  ]
}
