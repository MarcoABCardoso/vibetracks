                         "notes": [["D2", 4], ["C2", 4], ["Bb1", 4], ["A2", 4],
                                   ["D2", 4], ["G2", 4], ["A2", 4], ["D2", 4]] }
      }
    },
    {
      "name": "B",
      "bars": 8,
      "bpm": 96,
