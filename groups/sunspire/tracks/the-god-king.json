{
  "name": "the-god-king",
  "extends": "../soundtrack.json",
  "_comment": "Boss. The fallen sun-god who rules the ruins. His terror is the hero_theme corrupted — its opening cell dropped an octave and inverted in the low brass — while the omen cell coils through the choir and the harmony grinds through diminished chords over a relentless double-time taiko. Grand AND monstrous. A(menace) then B(full wrath), which loops.",
  "bpm": 152,
  "time_signature": [4, 4],
  "loops": 1,

  "sections": [
    {
      "name": "intro",
      "bars": 4,
      "bpm": 138,
      "bpm_end": 152,
      "_comment": "The throne wakes and quickens (accelerando 138 -> 152): aura sub on D, tremolo swells to the leading-tone dim, choir groans low, taiko heartbeat doubling — dread gathering speed.",
      "parts": {
        "aura":    { "instrument": "aura", "notes": [["D2", 16]], "gain": 1.0 },
        "tremolo": { "instrument": "tremolo", "chords": ["Dm", "Dm", "C#dim", "A"], "chord_beats": 4, "gain": 0.65 },
        "choir":   { "instrument": "choir", "chords": ["Dm", "Dm", "C#dim", "A"], "chord_beats": 4, "octave": 3, "gain": 0.45 },
        "taiko":   { "instrument": "taiko", "gain": 0.7, "notes": [["D2", 1], ["D2", 1]], "repeat": 8 }
      }
    },
    {
      "name": "A",
      "bars": 8,
      "_comment": "Trombone speaks the corrupted hero antecedent (its whole opening phrase dropped an octave and inverted into a coiling low line); bassoon answers with the omen; tremolo grinds through dim chords; choir chants low; taiko drives double-time.",
      "parts": {
        "trombone": { "instrument": "trombone", "motif": "hero_theme", "slice": [0, 8], "invert": "D3", "transpose": -12, "repeat": 4, "pan": -0.1, "gain": 0.8 },
        "bassoon":  { "instrument": "bassoon", "motif": "omen", "repeat": 8, "pan": 0.15, "gain": 0.6 },
        "tremolo":  { "instrument": "tremolo", "chords": ["Dm", "Ebdim", "C#dim", "A", "Gm", "Ebdim", "A", "A"], "chord_beats": 4, "gain": 0.6 },
        "choir":    { "instrument": "choir", "chords": ["Dm", "Dm", "A", "A", "Gm", "Gm", "A", "A"], "chord_beats": 4, "octave": 3, "gain": 0.5 },
        "taiko":    { "instrument": "taiko", "gain": 0.75, "notes": [["D2", 0.5], ["D2", 0.5]], "repeat": 32 },
        "timpani":  { "instrument": "timpani", "gain": 0.6,
                      "notes": [["D2", 0.5], ["D2", 0.5], [null, 1], ["A2", 0.5], [null, 1.5]], "repeat": 8 },
        "aura":     { "instrument": "aura", "notes": [["D2", 32]], "gain": 0.9 }
      }
    },
    {
      "name": "B",
      "bars": 8,
      "loop": true,
      "_comment": "Full wrath and loop point: brass tutti blasts the corrupted theme, trumpet shrieks the fanfare inverted, full choir, tremolo high, taiko + timpani relentless. The god-king unbound.",
      "parts": {
        "brass":    { "instrument": "brass", "motif": "hero_theme", "slice": [0, 8], "invert": "D4", "transpose": -12, "repeat": 4, "pan": -0.1, "gain": 0.85 },
        "trombone": { "instrument": "trombone", "motif": "omen", "repeat": 8, "transpose": -12, "pan": 0.1, "gain": 0.6 },
        "trumpet":  { "instrument": "trumpet", "motif": "fanfare", "invert": "A4", "repeat": 8, "pan": 0.2, "gain": 0.5 },
        "choir":    { "instrument": "choir", "chords": ["Dm", "Ebdim", "C#dim", "A", "Gm", "Ebdim", "A", "A"], "chord_beats": 4, "gain": 0.6 },
        "tremolo":  { "instrument": "tremolo", "chords": ["Dm", "Ebdim", "C#dim", "A", "Gm", "Ebdim", "A", "A"], "chord_beats": 4, "octave": 4, "gain": 0.55 },
        "taiko":    { "instrument": "taiko", "gain": 0.8, "notes": [["D2", 0.5], ["D2", 0.5]], "repeat": 32 },
        "timpani":  { "instrument": "timpani", "gain": 0.65,
                      "notes": [["D2", 1], ["D2", 1], ["D2", "1/3"], ["D2", "1/3"], ["D2", "1/3"], ["A2", 1], ["A2", 1], ["A2", 1], ["A2", 1]], "repeat": 4 },
        "cello":    { "instrument": "cello", "gain": 0.85,
                      "notes": [["D2", 0.5], ["D2", 0.5], ["D2", 0.5], ["D2", 0.5], ["Eb2", 0.5], ["Eb2", 0.5], ["Eb2", 0.5], ["Eb2", 0.5],
                                ["C#2", 0.5], ["C#2", 0.5], ["C#2", 0.5], ["C#2", 0.5], ["A1", 0.5], ["A1", 0.5], ["A1", 0.5], ["A1", 0.5],
                                ["G2", 0.5], ["G2", 0.5], ["G2", 0.5], ["G2", 0.5], ["Eb2", 0.5], ["Eb2", 0.5], ["Eb2", 0.5], ["Eb2", 0.5],
                                ["A1", 0.5], ["A1", 0.5], ["A1", 0.5], ["A1", 0.5], ["A1", 0.5], ["A1", 0.5], ["A1", 0.5], ["A1", 0.5]] },
        "bass":     { "instrument": "bass", "gain": 0.7,
                      "notes": [["D1", 4], ["Eb1", 4], ["C#1", 4], ["A0", 4],
                                ["G1", 4], ["Eb1", 4], ["A0", 4], ["A0", 4]] }
      }
    }
  ]
}
