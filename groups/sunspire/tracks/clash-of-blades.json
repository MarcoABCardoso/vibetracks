{
  "name": "clash-of-blades",
  "extends": "../soundtrack.json",
  "_comment": "Battle. The hero_theme is compressed to double-speed (diminution) and hammered out by the horns as a driving riff, with the 'omen' cell snarling underneath in the low brass. Taiko and timpani pound eighths; pizz + cello drive the bass. A(statement) then B(heavier, trumpet + choir stabs) which loops.",
  "bpm": 150,
  "time_signature": [4, 4],
  "loops": 1,

  "sections": [
    {
      "name": "intro",
      "bars": 4,
      "_comment": "Drums call to arms: taiko + timpani build, pizz stabs, no melody.",
      "parts": {
        "taiko":   { "instrument": "taiko", "gain": 0.85,
                     "notes": [["D2", 0.5]], "repeat": 32 },
        "timpani": { "instrument": "timpani", "gain": 0.7,
                     "notes": [["D2", 1], ["A2", 1], ["D2", 1], ["A2", 1]], "repeat": 4 },
        "pizz":    { "instrument": "pizz", "chords": ["Dm", "Dm", "A", "A"], "chord_beats": 4, "gain": 0.6 },
        "aura":    { "instrument": "aura", "notes": [["D2", 16]], "gain": 0.9 }
      }
    },
    {
      "name": "A",
      "bars": 8,
